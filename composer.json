{
  "name": "leaplogic/craftcms-redirect",
  "description": "Editor-managed redirects and a 404 log for Craft CMS 5.",
  "type": "craft-plugin",
  "license": "MIT",
  "authors": [{"name": "Michael", "email": "michael@leaplogic.net"}],
  "require": {"php": "^8.2", "craftcms/cms": "^5.0"},
  "require-dev": {"phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"leaplogic\\redirects\\": "src/"}},
  "autoload-dev": {"psr-4": {"leaplogic\\redirects\\tests\\": "tests/"}},
  "extra": {"handle": "redirects", "name": "Redirects", "developer": "Leap Logic", "developerUrl": "https://leaplogic.net", "class": "leaplogic\\redirects\\Plugin"},
  "scripts": {"test": "phpunit"},
  "config": {"allow-plugins": {"craftcms/plugin-installer": true, "yiisoft/yii2-composer": true}}
}
